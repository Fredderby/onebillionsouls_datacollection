DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=souls

# Optional: root password for the Compose MySQL container (defaults to souls_root_password)
# MYSQL_ROOT_PASSWORD=choose-a-root-password

# Docker Compose reads DB_HOST and DB_PORT above directly. Use your external
# MySQL host/port there. Only use DB_HOST=db with DB_PORT=3306 when you want the
# app to use the bundled Compose db service.

# Admin area — replace all three before using /admin
SECRET_KEY=replace-with-a-long-random-string
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-strong-password
